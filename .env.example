APP_NAME=TOTOD 知乎运营助手
APP_ENV=production
APP_SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=postgresql+asyncpg://totod:change-database-password@postgres:5432/totod
REDIS_URL=redis://redis:6379/0
ACCOUNT_DATA_ROOT=/var/lib/totod/accounts
DEFAULT_TIMEZONE=Asia/Shanghai
POSTGRES_DB=totod
POSTGRES_USER=totod
POSTGRES_PASSWORD=change-database-password
